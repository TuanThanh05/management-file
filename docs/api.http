# API Auth, Admin, Catalog, Labels, Records – dùng với REST Client (VS Code) hoặc chép sang Postman.
# Cookie rr_session được trình duyệt/REST Client tự lưu sau khi đăng nhập.
# Frontend React: fetch(..., { credentials: 'include' }) hoặc axios withCredentials: true.

@base = http://localhost:3000/api

### Kiểm tra sống
GET {{base}}/health

### Đăng nhập (BM08) – 200: { mustChangePassword, sessionExpiresAt } + Set-Cookie
# 401 INVALID_CREDENTIALS: "Tên đăng nhập hoặc mật khẩu không đúng" | 422: sai định dạng | 429: gọi quá nhiều
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "admin@congty.vn",
  "password": "MAT_KHAU_TAM"
}

### Thông tin người đang đăng nhập – vai trò, quyền kèm phạm vi, mustChangePassword
GET {{base}}/auth/me

### Đổi mật khẩu (BM09) – 200 + cookie phiên mới; 422 kèm danh sách lỗi theo trường
POST {{base}}/auth/change-password
Content-Type: application/json

{
  "currentPassword": "MAT_KHAU_TAM",
  "newPassword": "MatKhauMoi@2026x",
  "confirmPassword": "MatKhauMoi@2026x"
}

### Đăng xuất – 204
POST {{base}}/auth/logout

# ==================== ADMIN (chỉ Quản trị hệ thống) ====================
# Lỗi chung: 401 chưa đăng nhập | 403 không có quyền hoặc thao tác lên chính mình | 409 vi phạm quy tắc | 422 dữ liệu sai

### Danh sách phòng ban (kèm Trưởng phòng, số tài khoản hoạt động)
GET {{base}}/admin/departments

### Thêm phòng ban (BM20) – mã tự viết hoa, không sửa được
POST {{base}}/admin/departments
Content-Type: application/json

{ "code": "KT", "name": "Phòng Kế toán", "parentCode": null }

### Sửa phòng ban – chỉ tên và phòng ban cha
PATCH {{base}}/admin/departments/KT
Content-Type: application/json

{ "name": "Phòng Tài chính – Kế toán" }

### Ngừng hoạt động (chỉ khi không còn tài khoản hoạt động)
POST {{base}}/admin/departments/KT/deactivate

### Mở lại phòng ban
POST {{base}}/admin/departments/KT/activate

### Danh sách tài khoản: lọc q, departmentCode, status, role; phân trang page, pageSize
GET {{base}}/admin/users?departmentCode=KT&role=EMPLOYEE&page=1&pageSize=20

### Chi tiết tài khoản
GET {{base}}/admin/users/2

### Tạo tài khoản (BM21) – 201: { user, tempPassword } (mật khẩu tạm chỉ trả về một lần)
POST {{base}}/admin/users
Content-Type: application/json

{ "email": "nv.a@congty.vn", "fullName": "Nguyễn Văn A", "departmentCode": "KT", "roles": ["EMPLOYEE"] }

### Sửa họ tên / phòng ban (Trưởng phòng phải thu hồi vai trò trước khi chuyển phòng)
PATCH {{base}}/admin/users/2
Content-Type: application/json

{ "fullName": "Nguyễn Văn An" }

### Khóa tài khoản (hủy mọi phiên)
POST {{base}}/admin/users/2/lock

### Mở khóa tài khoản
POST {{base}}/admin/users/2/unlock

### Đặt lại mật khẩu – 200: { tempPassword }
POST {{base}}/admin/users/2/reset-password

### Đặt lại vai trò (BM21 phần B) – gửi đủ danh sách vai trò mới; hủy phiên của người bị đổi
# Mã vai trò: EMPLOYEE, DEPARTMENT_HEAD, RECORDS_OFFICER, DIRECTOR, SYSTEM_ADMIN
PUT {{base}}/admin/users/2/roles
Content-Type: application/json

{ "roles": ["EMPLOYEE", "DEPARTMENT_HEAD"] }

### Danh sách tham số (BM22)
GET {{base}}/admin/settings

### Sửa tham số – kiểm tra theo kiểu và khoảng cho phép
PATCH {{base}}/admin/settings/DISPOSAL_WAIT_DAYS
Content-Type: application/json

{ "value": 3 }

# ==================== CATALOG (ghi: Cán bộ lưu trữ; đọc: ai cần chọn loại tài liệu) ====================

### Danh sách nhóm hồ sơ
GET {{base}}/catalog/groups

### Thêm nhóm (BM14)
POST {{base}}/catalog/groups
Content-Type: application/json

{ "code": "KETOAN", "name": "Hồ sơ kế toán", "description": "Chứng từ, sổ sách kế toán" }

### Sửa nhóm – chỉ tên, mô tả
PATCH {{base}}/catalog/groups/KETOAN
Content-Type: application/json

{ "name": "Hồ sơ tài chính – kế toán" }

### Ngừng sử dụng nhóm (khi không còn nhãn hiệu lực) / mở lại
POST {{base}}/catalog/groups/KETOAN/deactivate
###
POST {{base}}/catalog/groups/KETOAN/activate

### Danh sách loại tài liệu – usable=true: dùng được để tạo hồ sơ
GET {{base}}/catalog/document-types?groupCode=KETOAN&usable=true

### Thêm loại tài liệu (BM15) – chưa có nhãn nên chưa dùng được
POST {{base}}/catalog/document-types
Content-Type: application/json

{ "code": "HD-GTGT", "name": "Hóa đơn GTGT", "groupCode": "KETOAN" }

### Sửa loại – chỉ tên, mô tả
PATCH {{base}}/catalog/document-types/HD-GTGT
Content-Type: application/json

{ "description": "Hóa đơn giá trị gia tăng đầu vào, đầu ra" }

### Ngừng sử dụng / mở lại loại
POST {{base}}/catalog/document-types/HD-GTGT/deactivate
###
POST {{base}}/catalog/document-types/HD-GTGT/activate

# ==================== LABELS (lập: Cán bộ lưu trữ; duyệt: Giám đốc; xem: cả hai) ====================

### Danh sách nhãn kèm phiên bản hiệu lực, loại đang gắn, đề xuất đang mở
GET {{base}}/labels

### Lịch sử mọi phiên bản của nhãn (kèm số hồ sơ đang gắn)
GET {{base}}/labels/KT-10N

### So sánh 2 phiên bản
GET {{base}}/labels/KT-10N/compare?from=1&to=2

### Lập đề xuất Tạo mới (BM02) – lưu Nháp
# retentionType: FIXED | PERMANENT; startTrigger: ARCHIVED_DATE | FISCAL_YEAR_END | EVENT_END (cần eventName)
POST {{base}}/labels/proposals
Content-Type: application/json

{
  "proposalType": "CREATE",
  "labelCode": "KT-10N",
  "groupCode": "KETOAN",
  "labelName": "Chứng từ kế toán 10 năm",
  "legalBasis": "Điều 41 Luật Kế toán 2015; Điều 13 Nghị định 174/2016/NĐ-CP",
  "retentionType": "FIXED",
  "retentionYears": 10,
  "startTrigger": "FISCAL_YEAR_END",
  "warningDays": 30,
  "containsPersonalData": false,
  "documentTypeCodes": ["HD-GTGT"],
  "proposalReason": "Thiết lập ban đầu cho chứng từ kế toán"
}

### Lập đề xuất Sửa nhãn (tạo phiên bản mới, bản cũ vẫn hiệu lực tới khi duyệt)
POST {{base}}/labels/proposals
Content-Type: application/json

{
  "proposalType": "UPDATE", "labelCode": "KT-10N", "labelName": "Chứng từ kế toán 10 năm",
  "legalBasis": "Điều 41 Luật Kế toán 2015", "retentionType": "FIXED", "retentionYears": 10,
  "startTrigger": "FISCAL_YEAR_END", "warningDays": 60, "containsPersonalData": false,
  "documentTypeCodes": ["HD-GTGT"], "proposalReason": "Tăng số ngày cảnh báo lên 60"
}

### Lập đề xuất Ngừng áp dụng (khi không còn loại đang sử dụng gắn với nhãn)
POST {{base}}/labels/proposals
Content-Type: application/json

{ "proposalType": "DEACTIVATE", "labelCode": "KT-10N", "proposalReason": "Không còn phát sinh loại tài liệu này" }

### Danh sách đề xuất chờ duyệt (màn hình Giám đốc)
GET {{base}}/labels/proposals?status=PENDING

### Chi tiết đề xuất – kèm so sánh với bản hiệu lực (comparison) và cảnh báo rút ngắn (warnings)
GET {{base}}/labels/proposals/1

### Sửa đề xuất ở Nháp / Bị từ chối – gửi trường nào sửa trường đó
PATCH {{base}}/labels/proposals/1
Content-Type: application/json

{ "retentionYears": 12, "documentTypeCodes": ["HD-GTGT"] }

### Gửi Giám đốc / Rút lại
POST {{base}}/labels/proposals/1/submit
###
POST {{base}}/labels/proposals/1/withdraw

### Giám đốc phê duyệt – trả về typesWithoutLabel: loại bị bỏ ra khỏi bản mới (mất nhãn)
POST {{base}}/labels/proposals/1/approve

### Giám đốc từ chối – lý do 10–500 ký tự
POST {{base}}/labels/proposals/1/reject
Content-Type: application/json

{ "comment": "Căn cứ pháp lý chưa đúng điều khoản" }

# ==================== RECORDS (Nhân viên, Trưởng phòng tạo; xem theo phạm vi) ====================

### Xem trước hạn lưu trữ dự kiến khi điền phiếu (BM01 trường 10)
GET {{base}}/records/expiry-preview?documentTypeCode=HD-GTGT&documentDate=2026-06-15

### Tạo hồ sơ (BM01) – 201: chi tiết hồ sơ, mã HS-<PB>-<Năm>-<6 số>
POST {{base}}/records
Content-Type: application/json

{ "title": "Hóa đơn GTGT số 0012345", "documentTypeCode": "HD-GTGT", "documentDate": "2026-06-15", "description": "Hóa đơn mua văn phòng phẩm" }

### Chi tiết hồ sơ: nhãn, hạn lưu trữ (expiry.official=false là dự kiến), file + phiên bản, lịch sử
GET {{base}}/records/HS-KT-2026-000001

### Sửa hồ sơ (chỉ người tạo, khi Đang sử dụng)
PATCH {{base}}/records/HS-KT-2026-000001
Content-Type: application/json

{ "title": "Hóa đơn GTGT số 0012346", "documentDate": "2026-06-16" }

### Tải file lên (multipart, trường "file"): PDF, DOCX, XLSX, JPG, PNG; đuôi phải khớp nội dung
POST {{base}}/records/HS-KT-2026-000001/files
Content-Type: multipart/form-data; boundary=----b

------b
Content-Disposition: form-data; name="file"; filename="hoa-don.pdf"
Content-Type: application/pdf

< ./hoa-don.pdf
------b--

### Thay file: tạo phiên bản mới cho file 1
POST {{base}}/records/HS-KT-2026-000001/files/1/versions
Content-Type: multipart/form-data; boundary=----b

------b
Content-Disposition: form-data; name="file"; filename="hoa-don-v2.pdf"
Content-Type: application/pdf

< ./hoa-don-v2.pdf
------b--

### Tải file về (phiên bản mới nhất). 409 FILE_INTEGRITY_FAILED: file bị sửa trong kho; 410: hồ sơ đã hủy
GET {{base}}/records/HS-KT-2026-000001/files/1/content

### Xem trực tiếp phiên bản 1 (PDF, ảnh) – download=0
GET {{base}}/records/HS-KT-2026-000001/files/1/content?version=1&download=0

### Gỡ file khỏi danh sách đang dùng (vẫn giữ lịch sử)
POST {{base}}/records/HS-KT-2026-000001/files/1/remove

### Hủy bỏ hồ sơ tạo nhầm (BM06) – không hoàn tác được
POST {{base}}/records/HS-KT-2026-000001/cancel
Content-Type: application/json

{ "reason": "Tạo nhầm loại tài liệu", "confirm": true }

### ---------- Ngày 6: gửi / duyệt lưu trữ, tra cứu, hết hiệu lực ----------

### Tra cứu (BM07): q tìm "chứa chuỗi" trên mã và tiêu đề; status nhiều giá trị cách nhau dấu phẩy; 20 dòng/trang
GET {{base}}/records?q=hóa đơn&status=ARCHIVED,EXPIRED&expiryDateFrom=2036-01-01&expiryDateTo=2036-12-31&sortBy=expiryDate&sortDir=asc&page=1

### Hồ sơ của tôi
GET {{base}}/records?mine=true

### Gửi yêu cầu lưu trữ (người tạo; cần ít nhất 1 file)
POST {{base}}/records/HS-KT-2026-000001/submit

### Rút yêu cầu lưu trữ
POST {{base}}/records/HS-KT-2026-000001/withdraw

### Hàng chờ duyệt (Trưởng phòng: hồ sơ phòng mình; Cán bộ lưu trữ: hồ sơ do Trưởng phòng tạo)
GET {{base}}/records/approvals

### Duyệt lưu trữ: gắn nhãn, tính hạn chính thức
POST {{base}}/records/HS-KT-2026-000001/approve

### Từ chối lưu trữ (lý do 10–500 ký tự)
POST {{base}}/records/HS-KT-2026-000001/reject
Content-Type: application/json

{ "reason": "Thiếu phụ lục hợp đồng số 2" }

### Đánh dấu hết hiệu lực (BM11) – nhãn theo sự kiện bắt buộc eventEndDate
POST {{base}}/records/HS-KT-2026-000001/mark-ended
Content-Type: application/json

{ "eventEndDate": "2026-11-20", "eventNote": "Thanh lý hợp đồng" }

### ---------- Ngày 7: quét hạn, cảnh báo, gia hạn, phong tỏa, thông báo ----------

### Quản trị viên chạy tay job quét hạn
POST {{base}}/admin/jobs/expiry-scan/run

### Lịch sử chạy tác vụ
GET {{base}}/admin/jobs/runs?jobName=EXPIRY_SCAN&page=1

### Trưởng phòng: cảnh báo hạn của phòng (upcoming / expired / undetermined)
GET {{base}}/retention/alerts

### Cán bộ lưu trữ: rà soát hồ sơ hết hạn mọi phòng
GET {{base}}/retention/expired?departmentCode=KT&expiryDateFrom=2020-01-01&page=1

### Cán bộ lưu trữ: đánh dấu đủ điều kiện hủy (eligible=false để bỏ dấu)
POST {{base}}/retention/eligibility
Content-Type: application/json

{ "recordCodes": ["HS-KT-2026-000001"], "eligible": true }

### Nhân viên: lập đề xuất gia hạn (BM03)
POST {{base}}/extensions
Content-Type: application/json

{ "recordCode": "HS-KT-2026-000001", "newExpiryDate": "2028-12-31", "reason": "Còn cần đối chiếu thanh tra thuế" }

### Theo dõi đề xuất gia hạn
GET {{base}}/extensions?status=PENDING&page=1

### Trưởng phòng duyệt gia hạn
POST {{base}}/extensions/GH-2026-0001/approve
Content-Type: application/json

{ "comment": "Đồng ý" }

### Trưởng phòng từ chối gia hạn (lý do 10–500 ký tự)
POST {{base}}/extensions/GH-2026-0001/reject
Content-Type: application/json

{ "comment": "Hồ sơ đã đối chiếu xong, không cần giữ" }

### Giám đốc đặt phong tỏa (JSON; muốn kèm tệp căn cứ thì gửi multipart, trường file "evidence", recordCodes cách nhau dấu phẩy)
POST {{base}}/holds
Content-Type: application/json

{ "recordCodes": ["HS-KT-2026-000001"], "reason": "Thanh tra thuế năm 2026", "legalBasis": "QĐ 12/QĐ-TTr", "expectedReleaseDate": "2027-03-31" }

### Tra cứu lệnh phong tỏa (status=ACTIVE|RELEASED, overdue=true: quá ngày dự kiến gỡ)
GET {{base}}/holds?status=ACTIVE

### Gỡ phong tỏa cả lệnh (thêm recordCodes để gỡ từng hồ sơ)
POST {{base}}/holds/PT-2026-0001/release
Content-Type: application/json

{ "reason": "Kết thúc đợt thanh tra thuế" }

### Tải tệp căn cứ của lệnh
GET {{base}}/holds/PT-2026-0001/evidence

### Thông báo của tôi (unread=true: chỉ chưa đọc)
GET {{base}}/notifications?unread=true

### Số thông báo chưa đọc
GET {{base}}/notifications/unread-count

### Đánh dấu đã đọc
POST {{base}}/notifications/1/read

### Đánh dấu tất cả đã đọc
POST {{base}}/notifications/read-all

### ---------- Ngày 8: đợt hủy và duyệt 2 cấp ----------

### Cán bộ lưu trữ: chọn hồ sơ đủ điều kiện, chưa vào đợt nào
GET {{base}}/retention/expired?departmentCode=KT&eligibleOnly=true

### Lập đợt hủy (BM05)
POST {{base}}/disposals
Content-Type: application/json

{ "departmentCode": "KT", "reason": "Hồ sơ kế toán đã hết thời hạn lưu trữ", "recordCodes": ["HS-KT-2026-000001", "HS-KT-2026-000002"] }

### Sửa đợt Nháp: thêm / bớt hồ sơ, sửa lý do
PATCH {{base}}/disposals/DH-KT-2026-001
Content-Type: application/json

{ "removeRecordCodes": ["HS-KT-2026-000002"], "removeReason": "Phòng còn dùng để đối chiếu" }

### Hủy bỏ đợt Nháp
POST {{base}}/disposals/DH-KT-2026-001/cancel
Content-Type: application/json

{ "reason": "Lập nhầm phòng ban, làm lại" }

### Gửi đợt duyệt cấp 1
POST {{base}}/disposals/DH-KT-2026-001/submit

### Trưởng phòng: đề nghị loại một hồ sơ (bỏ đề nghị: /exclusions/remove với recordCode)
POST {{base}}/disposals/DH-KT-2026-001/exclusions
Content-Type: application/json

{ "recordCode": "HS-KT-2026-000001", "reason": "Còn cần cho kiểm toán năm sau" }

### Trưởng phòng: đồng ý cấp 1 (trả lại: /return-level-1 với reason)
POST {{base}}/disposals/DH-KT-2026-001/approve-level-1
Content-Type: application/json

{ "comment": "Đồng ý" }

### Giám đốc: phê duyệt cấp 2 (trả lại: /return-level-2 với reason)
POST {{base}}/disposals/DH-KT-2026-001/approve-level-2
Content-Type: application/json

{ "comment": "Đồng ý hủy" }

### Giám đốc: thu hồi quyết định hủy (BM17)
POST {{base}}/disposals/DH-KT-2026-001/revoke
Content-Type: application/json

{ "reason": "Có yêu cầu thanh tra mới", "confirm": true }

### Theo dõi đợt hủy (Giám đốc lọc status=PENDING_LEVEL_2 để xem đợt chờ mình duyệt)
GET {{base}}/disposals?status=PENDING_LEVEL_2

### Chi tiết đợt: danh mục, hồ sơ bị loại / rút, lịch sử xét duyệt
GET {{base}}/disposals/DH-KT-2026-001
