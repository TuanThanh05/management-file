# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CSDL: dùng tài khoản ứng dụng app_retention (đặc quyền tối thiểu), KHÔNG dùng root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_retention
DB_PASSWORD=ChangeMe_2026!
DB_NAME=records_retention
DB_POOL_SIZE=10

# Chỉ dùng khi chạy MySQL bằng Docker (compose.yaml)
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026!

# Nguồn được gọi API (frontend React), cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Khóa ký JWT, tối thiểu 32 ký tự. Sinh: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Cookie phiên chỉ gửi qua HTTPS (localhost vẫn chạy được). Chỉ đặt false khi thật cần.
COOKIE_SECURE=true
# Số lần gọi POST /api/auth/login tối đa mỗi IP trong 1 phút
LOGIN_RATE_LIMIT=10

# Khóa chủ bọc khóa của từng file (32 byte base64). Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MẤT KHÓA NÀY = MẤT TOÀN BỘ FILE TRONG KHO. Sao lưu riêng, tách khỏi máy chủ; không commit, không gửi qua chat.
MASTER_KEY_BASE64=

# Thư mục kho file đã mã hóa và biên bản
STORAGE_DIR=./storage

# Sao lưu hằng ngày (5.5 CN7). Bỏ trống BACKUP_KEY_BASE64 hoặc BACKUP_DB_PASSWORD = tắt sao lưu.
# Thư mục chứa bản sao lưu; nên trỏ sang ổ đĩa / máy khác với máy chủ ứng dụng
BACKUP_DIR=./backups
# Khóa mã hóa bản sao lưu (32 byte base64), PHẢI KHÁC khóa chủ. Sinh như MASTER_KEY_BASE64. Mất khóa = không đọc được bản sao lưu.
BACKUP_KEY_BASE64=
# Tài khoản MySQL chỉ đọc dùng cho mysqldump (tạo sẵn trong database/records_retention.sql)
BACKUP_DB_USER=backup_retention
BACKUP_DB_PASSWORD=ChangeMe_Backup_2026!
# Đường dẫn mysqldump (bản MySQL 8, không dùng bản MariaDB)
MYSQLDUMP_PATH=mysqldump
