# Sao chép thành .env rồi sửa giá trị. KHÔNG commit file .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CSDL: dùng tài khoản ứng dụng app_retention (không có DELETE/DDL), KHÔNG dùng root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_retention
DB_PASSWORD=ChangeMe_2026!
DB_NAME=records_retention
DB_POOL_SIZE=10

# Chỉ dùng khi chạy MySQL bằng Docker (compose.yaml)
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026!

# Nguồn được gọi API (frontend React), cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Dùng từ ngày 2 (JWT) và ngày 5 (mã hóa file). Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
MASTER_KEY_BASE64=

STORAGE_DIR=./storage

MYSQL_ROOT_PASSWORD=